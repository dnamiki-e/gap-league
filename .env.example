# =============================================================================
# Gap League — 環境変数テンプレート
# 使い方: cp .env.example .env して各値を埋める（.env は git 管理外）
# =============================================================================

# --- アプリ ---
# 公開URL（末尾スラッシュなし）。招待リンクの生成にも使われる。
NEXTAUTH_URL=http://localhost:3020
# セッション暗号鍵。`openssl rand -base64 32` で生成して設定すること。
NEXTAUTH_SECRET=

# ベースパス。ルート直下に置くなら空のまま。サブパス配信時のみ設定（例: /gap）。
NEXT_PUBLIC_BASE_PATH=

# 【任意】試合日程・順位表・移籍・ニュースを持つ別サイトのURL。
# 設定するとリーグ画面にそこへのリンクが出る。未設定なら何も出ない。
# 例: https://example.com/football （/matches /standings /transfers /news を付けて開く）
NEXT_PUBLIC_FOOTBALL_INFO_URL=

# --- 認証モード ---
# ここから下の認証設定は、管理画面「管理 > 認証設定」で上書きできる。
# 画面で保存した値が優先され、保存していない項目だけこのファイルの値が使われる。
# 配布先が env だけで起動できるようにしつつ、起動後は画面から変えられる、という向き。
#
# password : メール+パスワードのみ（Google の設定は不要）
# google   : Google OAuth のみ
# both     : 両方（Google ログイン or メール/パスワード）
NEXT_PUBLIC_AUTH_MODE=password

# 利用者による自己登録を許可するか。
#   false（既定・招待制）: 管理者が「管理 > ユーザー」で発行したアカウントだけがログインできる。
#                          メール登録画面(/register)は閉じ、Google ログインも
#                          登録済みアドレス以外は拒否する。
#   true（開放）          : 誰でも /register から登録でき、任意の Google アカウントで入れる。
# 招待制でも ADMIN_EMAILS のアドレスは招待なしでログインできる（初期構築のため。
# User 行が1件も無い状態で招待制にすると、招待を出す管理者を作れないので）。
NEXT_PUBLIC_ALLOW_SIGNUP=false

# Google ログイン時に許可するメールドメイン（google / both モードで参照）。
# 空 = 制限なし（任意の Google アカウントがログイン可能）。
# 特定組織に限るなら設定する（例: example.com）。
# ドメインを設定した場合、そのドメイン宛の自己登録は拒否し Google ログインへ誘導する
# （第三者が同僚のアドレスを先に登録してアカウントを乗っ取るのを防ぐため）。
ALLOWED_EMAIL_DOMAIN=
# google / both モードで必要（Google Cloud Console で取得）。
# 管理画面から設定する場合はここは空でよい。
# Google 側に登録するリダイレクト URI は
#   ${NEXTAUTH_URL}${NEXT_PUBLIC_BASE_PATH}/api/auth/callback/google
# （管理画面の「認証設定」にコピー用の実値が出る）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 注意: 管理画面から保存したクライアントシークレットは NEXTAUTH_SECRET から
# 導出した鍵で暗号化して DB に入る。NEXTAUTH_SECRET を変えると復号できなくなり、
# 「未設定」扱いに戻る（管理画面で入れ直す）。

# --- 初期管理者 ---
# 1) `npm run seed` で投入する管理者（password モード用）。
#    メール+パスワードのアカウントを1件作り、isAdmin=true にする。
#    値は必ず自分のアドレスに書き換えること（下はサンプル）。
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
#
# 2) Google ログインで管理者にするアドレス（カンマ区切り、複数可）。
#    このアドレスで Google ログインすると自動で isAdmin=true になり、
#    招待制（NEXT_PUBLIC_ALLOW_SIGNUP=false）でも招待なしで入れる。
#    User 行が1件も無い状態から管理者を作るための入口なので、
#    初期構築が済んだら空にしておいてよい。
#    ADMIN_EMAIL（単数・seed 用）とは別物。両方使うこともできる。
#    値は必ず自分のアドレスに書き換えること（下はサンプル）。
ADMIN_EMAILS=admin@example.com

# --- データベース（PostgreSQL）---
DATABASE_URL=postgresql://USER@localhost:5432/gap_league

# --- 外部データ API ---
# チーム・順位表・試合・得点ランキング・スカッドの取得元。
# 通常はこの1行だけでよい。https://www.football-data.org/client/register で無料取得。
# 無料プランは 10リクエスト/分。アプリ側で直列化＋キャッシュして収めている。
FOOTBALL_DATA_API_KEY=

# 【任意】中継サーバ（Hub API）経由で取りたい場合のみ設定する。
# 両方が埋まっているときだけ Hub 経由になり、FOOTBALL_DATA_API_KEY は使われない。
# 複数アプリで football-data.org のレート枠を共有したい運用向けで、
# 単独で立てるだけなら不要。求められる API 仕様は docs/DATA_SOURCE.md 参照。
SOCCER_CRAWLER_BASE_URL=
SOCCER_CRAWLER_API_KEY=

# --- 自動同期（cron）---
# POST /api/cron/sync を叩くときの合言葉。
# 未設定だと同期エンドポイントは 503 を返して動かない（＝手動同期のみ）。
# `openssl rand -hex 32` などで生成する。設定方法は docs/OPERATIONS.md 参照。
CRON_SECRET=
